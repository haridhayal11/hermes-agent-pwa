HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
DB_PATH=

# Where the gateway keeps its cron state. Hermes has no way to deliver a
# scheduled job's result to a PWA — `deliver` only resolves to registered
# gateway platforms — but it writes every job's output here before it tries,
# and this app runs on the same host, so that file is the delivery path.
# Defaults to ~/.hermes/cron.
HERMES_CRON_DIR=

# Web Push. Generate a pair with: npx web-push generate-vapid-keys
# Leave both blank to turn notifications off — the app degrades to "the server
# has no VAPID keys" in Settings rather than failing.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# The VAPID `sub` claim — contact metadata for the push service. Nothing is
# ever sent to it, but it must be a *real* mailto: or https: URL: Apple
# validates it and answers 403 BadJwtToken for anything unroutable, which on
# iOS means push silently does nothing. Optional; defaults to the project repo.
VAPID_SUBJECT=
